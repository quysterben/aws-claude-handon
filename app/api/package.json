{
  "name": "api",
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "cdk": "cdk",
    "db:generate": "drizzle-kit generate",
    "db:migrate:remote": "aws lambda invoke --function-name api-migrate --cli-binary-format raw-in-base64-out --payload '{}' /tmp/api-migrate-output.json && cat /tmp/api-migrate-output.json"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1117.0",
    "@aws-sdk/client-rds-data": "^3.1117.0",
    "@aws-sdk/client-secrets-manager": "^3.1117.0",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.8.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "aws-cdk": "^2.1138.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
